# Banco de dados PostgreSQL.
# Dev local: aponte as duas para o mesmo Postgres local.
# Produção (Neon): DATABASE_URL é a connection string com pooling (host contém "-pooler"), usada
# pelo app em runtime; DIRECT_URL é a conexão direta (sem "-pooler"), usada só pelo Prisma Migrate.
DATABASE_URL="postgresql://user:password@localhost:5433/zhivago"
DIRECT_URL="postgresql://user:password@localhost:5433/zhivago"

# URL pública da própria API — usada para montar URLs persistidas (ex.: imagens de anúncios),
# nunca deve ser derivada do header Host da requisição.
# Dev local: http://localhost:3333 — Produção: URL pública do serviço no Cloud Run.
BASE_URL="http://localhost:3333"

# Porta HTTP do servidor. Em produção o Cloud Run injeta essa variável automaticamente — não
# defina manualmente lá. Em dev local pode deixar sem definir (cai no padrão 3333).
PORT=3333

# Nome do bucket do Google Cloud Storage onde os uploads (avatar, fotos de imóvel) são gravados.
# Sem essa variável, os uploads vão para o disco local (apps/server/uploads/) — use isso só em
# dev local. Em produção (Cloud Run) é obrigatório, pois o filesystem do container é efêmero.
GCS_BUCKET_NAME=""

# Credenciais do usuário ADMIN criado pelo prisma/seed.ts — nunca hardcoded no código.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Chave secreta JWT — gere uma string longa e aleatória própria para produção, nunca reaproveite
# a de dev (ex.: `openssl rand -base64 48`).
JWT_SECRET=""

# Origens do site Next.js autorizadas a fazer requisições CORS (separadas por vírgula).
# Dev local: http://localhost:3000 — Produção: URL(s) reais do apps/web em produção.
WEB_URL="http://localhost:3000"

# Web Push (VAPID) — par de chaves do site Next.js; a pública também precisa estar em
# apps/web/.env.local como NEXT_PUBLIC_VAPID_PUBLIC_KEY (o navegador usa a pública pra assinar
# a inscrição, a privada aqui é o que assina o envio). Gere com `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"

# Configurações de E-mail (Gmail) — use uma senha de app do Gmail, não a senha da conta.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
