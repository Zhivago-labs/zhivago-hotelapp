# Copie para deploy/vps/.env na VPS (nunca commite o .env real).
# Referência completa de cada variável: apps/server/.env.example.

# Domínio público da API — o DNS (registro A) precisa apontar pro IP da VPS antes do primeiro `up`,
# senão o Caddy não consegue emitir o certificado.
API_DOMAIN=api.zhivago.com.br

# Senha do Postgres — só caracteres seguros pra URL (gere com `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Mesmo valor de API_DOMAIN, com https:// — usado nas URLs de upload gravadas no banco.
BASE_URL=https://api.zhivago.com.br
WEB_URL=https://zhivago.com.br,https://zhivag0.netlify.app

# Copiar os valores atuais do Secret Manager (mesmos de produção, senão os logins/push quebram).
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FIREBASE_PROJECT_ID=

# Destino do backup fora da VPS — nome de um remote do rclone (ver seção 5 do plano).
BACKUP_REMOTE=
